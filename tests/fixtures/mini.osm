<?xml version="1.0" encoding="UTF-8"?>
<!-- Stradario minimo per provare l'importazione con osm2pgsql (tests/test_importa_osm.py): dati inventati.
     Due comuni (Acireale a est di lon 15.16, Aci Castello a ovest), provincia e regione sullo stesso quadrato,
     una statale nord-sud, una via residenziale e una strada in costruzione (da scartare). -->
<osm version="0.6" generator="a mano">
  <node id="1" version="1" lat="37.57" lon="15.16"/>
  <node id="2" version="1" lat="37.57" lon="15.18"/>
  <node id="3" version="1" lat="37.59" lon="15.18"/>
  <node id="4" version="1" lat="37.59" lon="15.16"/>
  <node id="5" version="1" lat="37.57" lon="15.14"/>
  <node id="6" version="1" lat="37.59" lon="15.14"/>
  <node id="10" version="1" lat="37.575" lon="15.1685"/>
  <node id="11" version="1" lat="37.585" lon="15.1685"/>
  <node id="12" version="1" lat="37.58" lon="15.169"/>
  <node id="13" version="1" lat="37.58" lon="15.175"/>
  <node id="14" version="1" lat="37.5801" lon="15.1684"/>
  <node id="15" version="1" lat="37.5802" lon="15.1687"/>
  <node id="20" version="1" lat="37.5795" lon="15.1685">
    <tag k="traffic_sign" v="city_limit"/>
    <tag k="name" v="Capomulini"/>
  </node>
  <node id="21" version="1" lat="37.581" lon="15.170">
    <tag k="place" v="village"/>
    <tag k="name" v="Capomulini"/>
    <tag k="population" v="1500"/>
  </node>
  <way id="100" version="1">
    <nd ref="1"/><nd ref="2"/><nd ref="3"/><nd ref="4"/><nd ref="1"/>
  </way>
  <way id="101" version="1">
    <nd ref="5"/><nd ref="1"/><nd ref="4"/><nd ref="6"/><nd ref="5"/>
  </way>
  <way id="200" version="1">
    <nd ref="10"/><nd ref="11"/>
    <tag k="highway" v="primary"/>
    <tag k="ref" v="SS 114"/>
    <tag k="name" v="Viale della Fiera Franca"/>
    <tag k="maxspeed" v="50"/>
  </way>
  <way id="201" version="1">
    <nd ref="12"/><nd ref="13"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Via Prova"/>
  </way>
  <way id="202" version="1">
    <nd ref="14"/><nd ref="15"/>
    <tag k="highway" v="construction"/>
  </way>
  <relation id="1000" version="1">
    <member type="way" ref="100" role="outer"/>
    <tag k="type" v="boundary"/>
    <tag k="boundary" v="administrative"/>
    <tag k="admin_level" v="8"/>
    <tag k="name" v="Acireale"/>
  </relation>
  <relation id="1001" version="1">
    <member type="way" ref="101" role="outer"/>
    <tag k="type" v="boundary"/>
    <tag k="boundary" v="administrative"/>
    <tag k="admin_level" v="8"/>
    <tag k="name" v="Aci Castello"/>
  </relation>
  <relation id="2000" version="1">
    <member type="way" ref="100" role="outer"/>
    <tag k="type" v="boundary"/>
    <tag k="boundary" v="administrative"/>
    <tag k="admin_level" v="6"/>
    <tag k="name" v="Catania"/>
    <tag k="ref" v="CT"/>
  </relation>
  <relation id="3000" version="1">
    <member type="way" ref="100" role="outer"/>
    <tag k="type" v="boundary"/>
    <tag k="boundary" v="administrative"/>
    <tag k="admin_level" v="4"/>
    <tag k="name" v="Sicilia"/>
  </relation>
</osm>
