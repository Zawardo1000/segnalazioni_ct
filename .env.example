# Configurazione del backend. Sul PC: copia in .env (facoltativo: compose.yaml ha gia' i valori per il PC).
# Sul server: nel .env dell'app, leggibile solo da root; percorsi e porta li fissa il compose del server.
# I nomi delle variabili sono i campi di segnalazioni/config.py in maiuscolo.

# Database Postgres con PostGIS (OBBLIGATORIA, SEGRETO: contiene la password).
# Sul PC la imposta compose.yaml; sul server: postgresql+psycopg://<utente>:<password>@postgres:5432/<database>
# DATABASE_URL=

# Chiave della pagina di prova dell'abbinamento (OBBLIGATORIA, SEGRETO): chi la conosce puo' usare l'app.
# Sul PC la imposta compose.yaml (prova); sul server si genera senza mostrarla, es. openssl rand -hex 24
# CHIAVE_ACCESSO=

# Facoltative, con i valori predefiniti di config.py:
# OVERPASS_URLS=["https://overpass.openstreetmap.fr/api/interpreter","https://overpass-api.de/api/interpreter"]
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# USER_AGENT=segnalazioni-ct/0.1 (+https://github.com/Zawardo1000/segnalazioni_ct)
# SALVA_FONTI=true            conserva le risposte di Overpass e Nominatim di ogni prova (per farne test)
# ISTAT_URL_REGIONE=https://www.istat.it/storage/cartografia/basi_territoriali/2021/R{regione:02d}_21.zip
#                             sezioni di censimento Istat per regione (popolazione dei centri abitati); le regioni
#                             sono in istat_regioni delle aree (OSM_AREE), predefinite: Sicilia 19, Lombardia 3

# --- Segnalazioni -------------------------------------------------------------------------------------------------
# Cartella delle foto (sul server fuori dal backup, scelta dell'utente); vuota = DATA_DIR/foto.
# FOTO_DIR=/foto
# Indirizzo pubblico della pagina, per i link privati delle segnalazioni nelle email.
# URL_PUBBLICO=https://segnalazioni.esempio.it
# Email con il link privato (una casella esistente via SMTP; con Gmail: verifica in due passaggi e una "password per
# le app"). L'indirizzo di chi chiede il link non si salva. Senza SMTP_HOST niente invio.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl               # ssl (porta 465) oppure starttls (porta 587)
# SMTP_USER=nome.cognome@gmail.com
# SMTP_PASSWORD=                  # SEGRETO: la password per le app, la scrive l'utente sul server
# SMTP_FROM=Segnalazioni CT <nome.cognome@gmail.com>

# --- Gestionale degli enti (login OpenID Connect con Keycloak) ------------------------------------------------------
# Realm (indirizzo pubblico) e client confidenziale; gli utenti hanno l'attributo OIDC_ATTRIBUTO ("amministratore"
# oppure "ente:<codice>", vedi python -m segnalazioni enti). Senza OIDC_ISSUER il gestionale è spento.
# OIDC_ISSUER=https://auth.esempio.it/realms/test_app
# OIDC_CLIENT_ID=segnalazioni-ct
# OIDC_CLIENT_SECRET=             # SEGRETO: generato sul server insieme al client
# OIDC_URL_INTERNO=http://keycloak:8080   # Keycloak dentro il server, per le chiamate dal backend
